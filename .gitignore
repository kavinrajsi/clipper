# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kept out of the repo and local-only. These were tracked until now; see the
# commit that removed them for what this costs.
#
# /supabase/ holds the migrations, config.toml, seed.sql and tests/rls.sql.
# Untracking it means a fresh clone cannot rebuild the database, and
# `supabase db push` refuses to run at all while a version recorded in the
# live project's supabase_migrations.schema_migrations has no local file —
# so anyone pushing a migration needs these files from elsewhere.
#
# /scripts/ backs npm run verify, test:rls, dev:session and both probes, so
# those scripts fail on a fresh clone too.
/supabase/
/docs/
/scripts/