# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# /supabase/ is tracked again. It was untracked in a93fc4d, and the cost that
# commit predicted came due: security fixes now live half in application code
# and half in migrations, and shipping the code without the schema means
# deploying against a database that has not got the object the code reads.
# Nothing in here is secret — config.toml takes every credential through
# env(...), and seed.sql creates local-only fixtures.
#
# /scripts/ and /docs/ are still untracked, so `npm run verify` (which shells
# out to scripts/rls-test.sh) and the probes still fail on a fresh clone.
/docs/
/scripts/